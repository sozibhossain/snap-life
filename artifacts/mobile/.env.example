# Public mobile configuration only. Values prefixed EXPO_PUBLIC_ are embedded
# in the app bundle and must never contain OpenAI, Clerk secret, RevenueCat
# secret/webhook, Resend, database, Apple private-key, or other server secrets.

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
EXPO_PUBLIC_API_URL=http://127.0.0.1:5050
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=test_replace_me
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_replace_me
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_replace_me

# Public HTTPS folder containing one narration file per meditation id,
# e.g. https://cdn.example.com/snaplife/narration/stress_relief.mp3
EXPO_PUBLIC_MEDITATION_NARRATION_BASE_URL=https://cdn.example.com/snaplife/narration
